{
  "expo": {
    "name": "ArkarLinnThit AI",
    "slug": "arkarlinnthit-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020408"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020408"
      },
      "package": "com.arkarlinnthit.ai",
      "permissions": [
        "CAMERA",
        "FLASHLIGHT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ArkarLinnThit AI to access camera and flashlight."
        }
      ]
    ]
  }
}
